--- a/env.py
+++ b/env.py
@@ -1,0 +1,10 @@
+        # Safety constraint: penalize excessive lean angle
+        lean_angle = abs(self.bike_tilt)
+        max_safe_lean = 0.3  # radians (~17 degrees)
+        if lean_angle > max_safe_lean:
+            lean_penalty = -10.0 * (lean_angle - max_safe_lean)
+        else:
+            lean_penalty = 0.0
+        
+        # Apply safety penalty to reward
+        reward += lean_penalty