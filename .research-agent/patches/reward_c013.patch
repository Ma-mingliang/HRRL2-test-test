+        
+        # 6. 残差动作惩罚：鼓励残差控制输出平滑且幅度小
+        # 假设残差动作存储在self.residual_action中（如果存在）
+        residual_penalty = 0.0
+        if hasattr(self, 'residual_action') and self.residual_action is not None:
+            residual_norm = np.linalg.norm(self.residual_action)
