--- a/env.py
+++ b/env.py
@@ -1,0 +1,11 @@
+    # Add residual action penalty for smoother control
+    if hasattr(self, 'prev_residual_action') and self.prev_residual_action is not None:
+        residual_norm = np.linalg.norm(residual_action)
+        smoothness_penalty = np.linalg.norm(residual_action - self.prev_residual_action)
+        
+        # Penalize residual action magnitude and roughness
+        lambda_res = 0.1
+        lambda_smooth = 0.05
+        reward -= lambda_res * residual_norm**2 + lambda_smooth * smoothness_penalty
+    
+    self.prev_residual_action = residual_action.copy()