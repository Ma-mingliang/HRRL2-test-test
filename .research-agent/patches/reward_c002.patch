         if hasattr(self, 'prev_tracking_error'):
             tracking_improvement = abs(self.prev_tracking_error) - abs(current_tracking_error)
             heading_improvement = abs(self.prev_heading_error) - abs(current_heading_error)
             gamma = 0.99
