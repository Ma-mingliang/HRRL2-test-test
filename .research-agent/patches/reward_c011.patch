--- a/env.py
+++ b/env.py
@@ -1,0 +1,14 @@
+    # Add residual action penalty for smoother control
+    if hasattr(self, 'prev_residual_action') and self.prev_residual_action is not None:
+        # Penalize residual action magnitude
+        residual_norm = np.linalg.norm(residual_action)
+        residual_penalty = 0.1 * residual_norm**2
+        
+        # Penalize residual action roughness (change between steps)
+        action_change = np.linalg.norm(residual_action - self.prev_residual_action)
+        smoothness_penalty = 0.05 * action_change**2
+        
+        reward -= residual_penalty + smoothness_penalty
+    
+    # Store current residual action for next step
+    self.prev_residual_action = residual_action.copy()